# Configuration for Audio Orchestrator

# Snapcast TCP JSON-RPC host and port (default: localhost:1705)
SNAPCAST_HOST=localhost
SNAPCAST_PORT=1705

# Internal webhook URL used by dynamic Spotify and Radio containers to reach Orchestrator
ORCHESTRATOR_INTERNAL_URL=http://localhost:5000

# Base directory for raw audio PCM FIFOs (default: /tmp/audio_fifos)
FIFO_BASE_DIR=/tmp/audio_fifos

# Default Docker image for Spotify Connect nodes (librespot-server)
SPOTIFY_NODE_IMAGE=ghcr.io/slaesh/librespot-server:0.3.0

# Default Docker image for standard FFmpeg radio streams
DOCKER_FFMPEG_IMAGE=jrottenberg/ffmpeg:4.1-alpine

# Default Docker image for Audalaxy radio metadata stream plugin
DOCKER_RADIO_AUDALAXY_IMAGE=ghcr.io/slaesh/radio-node-audalaxy:latest
