{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "audio-orchestrator",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/orchestrator/ClientApp/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "xml",
          "path": "apps/orchestrator/AudioOrchestrator.csproj",
          "xpath": "/Project/PropertyGroup/Version"
        }
      ]
    }
  }
}
